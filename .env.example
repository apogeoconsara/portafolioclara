# Environment variables for the Clara Growth Agent demo.
# Set these in Netlify (Site configuration -> Environment variables) or in a local,
# git-ignored .env for `netlify dev`. NEVER commit real values. None of these are
# read by the browser; they are only used by the Netlify Functions.

# --- Existing (unchanged) ---
ANTHROPIC_API_KEY=         # clara-agent-chat.mjs AND lead-reasoning.mjs (Claude Haiku 4.5; what n8n's "LLM analysis" node calls)
OPENAI_API_KEY=            # optional alternative LLM for lead-reasoning only (not needed if you use Anthropic)
LLM_PROVIDER=              # optional: "anthropic" | "openai" to force one; default = Anthropic when its key exists

# --- Growth Workflow (n8n -> HubSpot) ---
N8N_WEBHOOK_URL=           # n8n webhook PRODUCTION URL, https only (see docs/growth-automation-integration.md)
N8N_WEBHOOK_SECRET=        # optional but recommended: sent as header x-clara-secret; must match n8n's Header Auth credential
N8N_TIMEOUT_MS=            # optional, 1000-60000, default 25000
HUBSPOT_WRITEBACK=         # leave empty/false = HubSpot is READ-ONLY. Set to "true" only after creating the clara_* properties

# --- Lifecycle Copilot (Customer.io) — all server-side, none are read by the browser ---
# Sending is IMPOSSIBLE unless CUSTOMERIO_SEND_ENABLED is exactly "true" AND the recipient is in the allowlist.
CUSTOMERIO_SITE_ID=                  # Track API site id (credential check only)
CUSTOMERIO_TRACK_API_KEY=            # Track API key (credential check only)
CUSTOMERIO_APP_API_KEY=              # App API key: read-only profile lookups + the test send
CUSTOMERIO_SEND_ENABLED=             # default / empty = false = nothing can be sent. "true" only for TEST sends
CUSTOMERIO_TEST_ALLOWLIST=           # comma-separated test emails you own; the ONLY addresses a test send can reach
CUSTOMERIO_TRANSACTIONAL_MESSAGE_ID= # id of the (published) transactional message used for test sends
CUSTOMERIO_REGION=                   # optional: "eu" for EU workspaces (default us)
